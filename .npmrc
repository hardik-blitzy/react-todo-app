# npm configuration for react-todo-app
#
# This project targets the React 15.x / react-scripts 0.9.0 (Create React App,
# early 2017) toolchain. Its dependency tree predates npm 7's strict peer
# dependency resolution, so a plain `npm install` on npm >= 7 fails with
# ERESOLVE peer-dependency conflicts.
#
# Setting legacy-peer-deps=true restores the npm 6 behavior (peer deps are
# installed best-effort and conflicts are warnings, not errors), allowing
# `npm install` and `npm ci` to resolve the full tree on Node.js 20.x.
#
# Equivalent to running `npm install --legacy-peer-deps` explicitly.
legacy-peer-deps=true
