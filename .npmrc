# npm configuration for react-todo-app
#
# legacy-peer-deps:
#   Create React App (react-scripts@5.0.1) declares an optional peer dependency
#   of typescript "^3.2.1 || ^4", but this project intentionally uses
#   typescript ^5.3.0 (locked at 5.9.3). Under npm 7+ strict peer resolution
#   this raises ERESOLVE during `npm ci` / `npm install`. The package-lock.json
#   already pins exact, compatible versions, so relaxing strict peer resolution
#   here lets npm install the locked tree without altering any resolved version.
#   This is a build/tooling configuration choice (not a source-code change).
legacy-peer-deps=true
